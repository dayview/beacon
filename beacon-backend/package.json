        "exceljs": "^4.4.0",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.2.1",
        "helmet": "^8.0.0",
        "mongoose": "^8.10.1",
        "socket.io": "^4.8.1"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
